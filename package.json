{
  "name": "rcm-sports",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i assets/styles-input.css -o assets/site.css --minify && node scripts/build-editorial-css.mjs",
    "test:database": "node tests/database.mjs",
    "test:browser": "node tests/browser.cjs",
    "test": "npm run test:database && npm run test:picks && npm run test:auth && npm run test:drafts && npm run test:editor && npm run test:browser",
    "test:database:observed": "node -e \"process.env.RCM_OBSERVED_SCHEMA='1';import('./tests/database.mjs')\"",
    "test:picks": "node tests/community-picks.mjs && node tests/community-picks-ui.mjs",
    "test:capture": "node tests/pick-capture-parser.cjs && node tests/pick-ticket-parser.cjs && node tests/pick-capture-ui.mjs && node tests/pick-capture-database.mjs && node tests/pick-composer-direct.mjs",
    "test:capture:browser": "node tests/pick-capture-browser.cjs",
    "test:auth": "node tests/username-auth-ui.mjs",
    "test:editor": "node tests/news-editor.mjs && node tests/article-photo-edit.mjs",
    "test:drafts": "node tests/draft-guard.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "happy-dom": "21.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.17"
  }
}
