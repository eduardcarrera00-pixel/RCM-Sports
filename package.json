{
  "name": "rcm-sports",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i assets/styles-input.css -o assets/site.css --minify",
    "test:database": "node tests/database.mjs",
    "test:browser": "node tests/browser.cjs",
    "test": "npm run test:database && npm run test:ae && npm run test:browser",
    "test:database:observed": "node -e \"process.env.RCM_OBSERVED_SCHEMA='1';import('./tests/database.mjs')\"",
    "build:social": "node scripts/build-social.mjs",
    "test:ae": "node tests/ae-provider.mjs && node tests/ae-worker.mjs && node tests/ae-social.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
